%p{style: "color: green"}= notice

- content_for :title, "Movies"

%h1 Movies

%div.ordenacao
  %p Ordenar por:
  %div
    %span{class: (params[:sort] == "title" ? "destaque" : "link")}
      = link_to "Título", movies_path(sort: "title")
    %span{class: (params[:sort] == "rating" ? "destaque" : "link")}
      = link_to "Classificação", movies_path(sort: "rating")
    %span{class: (params[:sort] == "release_date" ? "destaque" : "link")}
      = link_to "Lançamento", movies_path(sort: "release_date")

%div{id: "movies"}
  - @movies.each do |movie|
    %div.filme
      %p.atributos.link
        = link_to movie.title, movie
      %p.atributos
        = "Classificação: "
        = movie.rating
      %p.atributos
        = "Descrição: "
        = movie.description
      %p.atributos
        = "Data de lançamento: "
        = movie.release_date

%p.link
  = link_to "(+) Novo filme", new_movie_path
