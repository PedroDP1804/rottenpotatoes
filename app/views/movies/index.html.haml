%p{style: "color: green"}= notice

- content_for :title, "Movies"

%h1 Movies

%div.ordenacao
  %p Ordenar por:
  %div
    %th= link_to "Título", movies_path(sort: "title")
    %th Classificação
    %th= link_to "Lançamento", movies_path(sort: "release_date")

%div{id: "movies"}
  - @movies.each do |movie|
    %div.filme
      %p.atributos
        = link_to movie.title, movie
      %p.atributos
        = "Classificação: "
        = movie.rating
      %p.atributos
        = "Descrição: "
        = movie.description
      %p.atributos
        = "Data de lançamento: "
        = movie.release_date

= link_to "Novo filme", new_movie_path
